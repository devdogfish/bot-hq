# Copy to .env and fill in. Never commit .env.
HQ_HOST=127.0.0.1
PORT=8787
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
DEV_LOGIN=0
ALLOWED_EMAILS=
# HQ_DATA_DIR=/absolute/path/to/bot-hq-data
# DB_PATH=/absolute/path/to/hq.db
# HQ_LIBRARY_DIR=/absolute/path/to/files
# MCP_BASE_URL=http://127.0.0.1:8787
# PRIMARY_BOT_NAME=Doug
# PRIMARY_BOT_LABEL=Chief of Staff

# Optional draft-only gateway registrations as JSON, keyed by Bot ID.
# Each entry needs its own isolated Hermes Runs endpoint and dedicated key.
# See docs/remote-agents.md before enabling this option.
# HQ_DRAFT_GATEWAYS=

# Optional Owner chat email. Keep these settings on the Bot HQ service.
# Map sender roles to their exact remote Agent bot IDs as a JSON object.
# HQ_OWNER_EMAIL_TARGETS=
# Enter exactly three Owner addresses as a JSON array and a verified sender domain.
# HQ_OWNER_EMAIL_TO=
# HQ_OWNER_EMAIL_FROM_DOMAIN=
# Use dedicated SES credentials for ca-central-1.
# BOT_HQ_EMAIL_SES_ACCESS_KEY_ID=
# BOT_HQ_EMAIL_SES_SECRET_ACCESS_KEY=

# Optional legacy local Hermes support. Register remote Agents under Engine in the details panel.
# HQ_LOCAL_ENGINES=1
# HERMES_BIN=hermes
# HERMES_URL=http://127.0.0.1:8642
# HERMES_HOME_PRIMARY=/absolute/path/to/hermes-home
# HERMES_KEY=
# ENGINES_DIR=/absolute/path/to/managed-engines
# ENGINE_PORT_BASE=8650

# Optional xAI voice and X research
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0
